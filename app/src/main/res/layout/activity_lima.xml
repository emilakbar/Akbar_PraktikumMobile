<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7FB"
    tools:context=".pertemuan5.LimaActivity">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#B39DDB"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="@android:color/white"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>


    <!-- BAGIAN YANG BISA DI-SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- JUDUL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pertemuan 5"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="20dp" />

            <!-- SUB JUDUL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CoordinatorLayout dan Scroll Toolbar"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:paddingBottom="16dp" />

            <!-- TOMBOL WEBVIEW -->
            <Button
                android:id="@+id/btnWebView"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Buka WebView"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/button_webview"
                android:elevation="3dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- PENJELASAN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scroll halaman ini ke bawah untuk melihat Toolbar menghilang. Kemudian scroll kembali ke atas untuk melihat Toolbar muncul kembali."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="20dp" />

            <!-- KONTEN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley, the librarian at St Bride Printing Library in London, took a 1914 Cicero translation and scrambled it to make dummy text for Letraset's Body Type sheets. It has survived not only many decades, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised thanks to these sheets and more recently with desktop publishing software like Aldus PageMaker and Microsoft Word including versions of Lorem Ipsum."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Konten tambahan untuk membuat halaman cukup panjang sehingga dapat di-scroll."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <!-- TAMBAHAN KONTEN 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagian tambahan 1&#10;&#10;CoordinatorLayout digunakan untuk mengatur hubungan posisi dan perilaku antar komponen pada halaman Android."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <!-- TAMBAHAN KONTEN 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagian tambahan 2&#10;&#10;NestedScrollView memungkinkan pengguna untuk menggulir konten halaman secara vertikal."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <!-- TAMBAHAN KONTEN 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagian tambahan 3&#10;&#10;AppBarLayout digunakan bersama Toolbar untuk memberikan efek Toolbar yang dapat menghilang ketika halaman digulir ke bawah."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

            <!-- TAMBAHAN KONTEN 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagian tambahan 4&#10;&#10;Silakan scroll halaman ini ke bawah dan kemudian kembali ke atas untuk melihat perubahan posisi Toolbar."
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="20dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>